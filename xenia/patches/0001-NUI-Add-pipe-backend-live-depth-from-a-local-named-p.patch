+#include "xenia/nui/pipe/pipe_nui_system.h"
+
+#include <algorithm>
+#include <cstring>
+
+#include "xenia/base/logging.h"
+#include "xenia/base/platform_win.h"
+#include "xenia/nui/depth_recording.h"
+#include "xenia/nui/nui_flags.h"
+
+namespace xe {
+namespace nui {
+namespace pipe {
+
+namespace {
+
+constexpr size_t kSampleBytes =
+    size_t(DepthFrame::kWidth) * DepthFrame::kHeight * sizeof(uint16_t);
+
+// Pipe names are spelled by the user on the command line; anything outside
+// this set is refused rather than escaped.
+bool IsValidPipeName(const std::string& name) {
+  return !name.empty() && name.size() <= 200 &&
+         std::all_of(name.begin(), name.end(), [](char c) {
+           return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+                  (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '.';
+         });
+}
+
+}  // namespace
+
+bool PipeNuiSystem::IsAvailable() { return !cvars::nui_pipe.empty(); }
+
+PipeNuiSystem::PipeNuiSystem() = default;
+
+PipeNuiSystem::~PipeNuiSystem() {
+  ClosePipe();
+  if (io_event_) {
+    CloseHandle(io_event_);
+  }
+  if (shutdown_event_) {
+    CloseHandle(shutdown_event_);
+  }
+}
+
+X_STATUS PipeNuiSystem::Setup(kernel::KernelState* kernel_state) {
+  X_STATUS result = NuiSystem::Setup(kernel_state);
+  if (result != X_STATUS_SUCCESS) {
+    return result;
+  }
+  const std::string& name = cvars::nui_pipe;
+  if (!IsValidPipeName(name)) {
+    XELOGE(
+        "NUI: nui_pipe \"{}\" is not a usable pipe name (letters, digits, - _ "
+        ". only).",
+        name);
+    return X_STATUS_UNSUCCESSFUL;
+  }
+  // The name is ASCII (checked above), so widening it char by char is exact.
+  pipe_path_utf8_ = "\\\\.\\pipe\\" + name;
+  pipe_path_ = std::wstring(pipe_path_utf8_.begin(), pipe_path_utf8_.end());
+
+  io_event_ = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+  shutdown_event_ = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+  if (!io_event_ || !shutdown_event_) {
+    XELOGE("NUI: failed to create the depth pipe's events.");
+    return X_STATUS_UNSUCCESSFUL;
+  }
+
+  worker_running_.store(true, std::memory_order_release);
+  worker_thread_ =
+      threading::Thread::Create({}, [this]() { WorkerThreadMain(); });
+  if (!worker_thread_) {
+    XELOGE("NUI: failed to start the depth pipe thread.");
+    worker_running_.store(false, std::memory_order_release);
+    return X_STATUS_UNSUCCESSFUL;
+  }
+  worker_thread_->set_name("NUI Pipe");
+  return X_STATUS_SUCCESS;
+}
+
+void PipeNuiSystem::Shutdown() {
+  worker_running_.store(false, std::memory_order_release);
+  if (worker_thread_) {
+    // Every wait in the worker also waits on this event, and a pending read is
+    // cancelled when it fires, so the join comes back.
+    SetEvent(shutdown_event_);
+    threading::Wait(worker_thread_.get(), false);
+    worker_thread_.reset();
+  }
+  ClosePipe();
+  NuiSystem::Shutdown();
+}
+
+void PipeNuiSystem::ClosePipe() {
+  if (pipe_) {
+    DisconnectNamedPipe(pipe_);
+    CloseHandle(pipe_);
+    pipe_ = nullptr;
+  }
+}
+
+bool PipeNuiSystem::AcceptClient() {
+  // Single instance, inbound only, and remote clients refused: depth frames
+  // come from this machine and go nowhere else.
+  pipe_ = CreateNamedPipeW(pipe_path_.c_str(),
+                           PIPE_ACCESS_INBOUND | FILE_FLAG_OVERLAPPED |
+                               FILE_FLAG_FIRST_PIPE_INSTANCE,
+                           PIPE_TYPE_BYTE | PIPE_READMODE_BYTE | PIPE_WAIT |
+                               PIPE_REJECT_REMOTE_CLIENTS,
+                           1, 0, DWORD(2 * kSampleBytes), 0, nullptr);
+  if (pipe_ == INVALID_HANDLE_VALUE) {
+    pipe_ = nullptr;
+    XELOGE(
+        "NUI: could not create the depth pipe (error {}); is another xenia "
+        "already serving it?",
+        GetLastError());
+    return false;
+  }
+
+  OVERLAPPED overlapped = {};
+  overlapped.hEvent = io_event_;
+  ResetEvent(io_event_);
+  if (ConnectNamedPipe(pipe_, &overlapped)) {
+    return true;
+  }
+  DWORD error = GetLastError();
+  if (error == ERROR_PIPE_CONNECTED) {
+    return true;
+  }
+  if (error != ERROR_IO_PENDING) {
+    XELOGE("NUI: waiting for a depth pipe writer failed (error {}).", error);
+    return false;
+  }
+  HANDLE handles[] = {shutdown_event_, io_event_};
+  if (WaitForMultipleObjects(2, handles, FALSE, INFINITE) !=
+      WAIT_OBJECT_0 + 1) {
+    CancelIoEx(pipe_, &overlapped);
+    DWORD ignored;
+    GetOverlappedResult(pipe_, &overlapped, &ignored, TRUE);
+    return false;
+  }
+  DWORD ignored;
+  return GetOverlappedResult(pipe_, &overlapped, &ignored, FALSE) != 0;
+}
+
+bool PipeNuiSystem::ReadExact(void* buffer, size_t size) {
+  auto* out = static_cast<uint8_t*>(buffer);
+  while (size) {
+    OVERLAPPED overlapped = {};
+    overlapped.hEvent = io_event_;
+    ResetEvent(io_event_);
+    DWORD read = 0;
+    DWORD chunk = DWORD(std::min<size_t>(size, 1u << 20));
+    if (!ReadFile(pipe_, out, chunk, &read, &overlapped)) {
+      if (GetLastError() != ERROR_IO_PENDING) {
+        return false;
+      }
+      HANDLE handles[] = {shutdown_event_, io_event_};
+      if (WaitForMultipleObjects(2, handles, FALSE, INFINITE) !=
+          WAIT_OBJECT_0 + 1) {
+        CancelIoEx(pipe_, &overlapped);
+        GetOverlappedResult(pipe_, &overlapped, &read, TRUE);
+        return false;
+      }
+      if (!GetOverlappedResult(pipe_, &overlapped, &read, FALSE)) {
+        return false;
+      }
+    }
+    if (!read) {
+      return false;
+    }
+    out += read;
+    size -= read;
+  }
+  return true;
+}
+
+void PipeNuiSystem::WorkerThreadMain() {
+  const std::string& path_utf8 = pipe_path_utf8_;
+  // The device is there as soon as the pipe is: a title that boots before the
+  // writer starts sees a sensor with nobody in front of it, not no sensor.
+  SetDeviceStatus(DeviceStatus::kInitializing);
+  SetDeviceStatus(DeviceStatus::kReady);
+
+  while (worker_running_.load(std::memory_order_acquire)) {
+    XELOGI("NUI: waiting for a depth writer on {}", path_utf8);
+    if (!AcceptClient()) {
+      ClosePipe();
+      if (worker_running_.load(std::memory_order_acquire)) {
+        SetDeviceStatus(DeviceStatus::kError);
+      }
+      break;
+    }
+
+    DepthRecordingHeader header = {};
+    if (!ReadExact(&header, sizeof(header)) ||
+        std::memcmp(header.magic, kDepthRecordingMagic, sizeof(header.magic)) ||
+        header.width != DepthFrame::kWidth ||
+        header.height != DepthFrame::kHeight) {
+      XELOGE(
+          "NUI: the depth pipe writer did not send a {}x{} depth recording "
+          "header; dropping it.",
+          DepthFrame::kWidth, DepthFrame::kHeight);
+      ClosePipe();
+      continue;
+    }
+    XELOGI("NUI: depth writer connected on {}", path_utf8);
+
+    uint64_t client_frames = 0;
+    while (worker_running_.load(std::memory_order_acquire)) {
+      DepthRecordingFrameHeader frame_header;
+      auto frame = frame_pool_.Acquire();
+      if (!ReadExact(&frame_header, sizeof(frame_header)) ||
+          !ReadExact(frame->depth_mm.data(), kSampleBytes)) {
+        break;
+      }
+      PublishFrame(std::move(frame));
+      ++client_frames;
+      if ((++published_frame_count_ % kFrameLogInterval) == 0) {
+        XELOGI("NUI: {} depth frames received from the pipe",
+               published_frame_count_);
+      }
+    }
+    if (worker_running_.load(std::memory_order_acquire)) {
+      XELOGI(
+          "NUI: depth writer on {} went away after {} frames; the last frame "
+          "stays current until the next one connects",
+          path_utf8, client_frames);
+    }
+    ClosePipe();
+  }
+}
+
+bool PipeNuiSystem::GetTiltDegrees(int32_t* out_degrees) {
+  if (!out_degrees || !IsDevicePresent()) {
+    return false;
+  }
+  if (GetTiltOverrideDegrees(out_degrees)) {
+    return true;
+  }
+  *out_degrees = tilt_degrees_.load(std::memory_order_acquire);
+  return true;
+}
+
+bool PipeNuiSystem::SetTiltDegrees(int32_t degrees) {
+  if (!IsDevicePresent() || !cvars::nui_allow_tilt) {
+    return false;
+  }
+  tilt_degrees_.store(
+      std::clamp(degrees, kTiltMinimumDegrees, kTiltMaximumDegrees),
+      std::memory_order_release);
+  return true;
+}
+
+}  // namespace pipe
+}  // namespace nui
+}  // namespace xe
