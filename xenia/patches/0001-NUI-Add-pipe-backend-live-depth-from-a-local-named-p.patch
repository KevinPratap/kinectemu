+#ifndef XENIA_NUI_PIPE_PIPE_NUI_SYSTEM_H_
+#define XENIA_NUI_PIPE_PIPE_NUI_SYSTEM_H_
+
+#include <atomic>
+#include <cstdint>
+#include <memory>
+#include <string>
+
+#include "xenia/base/threading.h"
+#include "xenia/nui/depth_frame_pool.h"
+#include "xenia/nui/nui_system.h"
+
+namespace xe {
+namespace nui {
+namespace pipe {
+
+// A NUI system that publishes depth frames another process on this machine
+// writes into a named pipe, \\.\pipe\<nui_pipe>, as they arrive. The stream is
+// a .xdepth recording sent live: one DepthRecordingHeader, then frames. It is
+// how a host-side depth source that is not a Kinect - a webcam pipeline that
+// synthesises depth, say - drives a title without being built into xenia.
+//
+// The pipe takes local clients only, one at a time. When the writer goes away
+// the pipe is opened again for the next one, and the last frame stays the
+// latest until then.
+class PipeNuiSystem : public NuiSystem {
+ public:
+  PipeNuiSystem();
+  ~PipeNuiSystem() override;
+
+  // True only when the nui_pipe cvar names a pipe, so --nui=any never picks
+  // this backend unasked.
+  static bool IsAvailable();
+
+  std::string name() const override { return "Depth pipe"; }
+
+  X_STATUS Setup(kernel::KernelState* kernel_state) override;
+  void Shutdown() override;
+
+  bool GetTiltDegrees(int32_t* out_degrees) override;
+  bool SetTiltDegrees(int32_t degrees) override;
+
+ private:
+  static constexpr uint64_t kFrameLogInterval = 300;
+
+  void WorkerThreadMain();
+  // Creates the pipe and waits for a writer. Returns false on shutdown or when
+  // the pipe cannot be created.
+  bool AcceptClient();
+  // Reads exactly size bytes from the connected writer. Returns false when the
+  // writer went away or shutdown was asked for.
+  bool ReadExact(void* buffer, size_t size);
+  void ClosePipe();
+
+  std::wstring pipe_path_;
+  std::string pipe_path_utf8_;
+  // Win32 handles, kept as void* so this header does not pull in windows.h.
+  void* pipe_ = nullptr;
+  void* io_event_ = nullptr;
+  void* shutdown_event_ = nullptr;
+
+  std::unique_ptr<threading::Thread> worker_thread_;
+  std::atomic<bool> worker_running_ = {false};
+
+  // Touched by the worker thread only.
+  uint64_t published_frame_count_ = 0;
+  DepthFramePool frame_pool_;
+
+  // No motor behind a pipe: the angle a title last asked for is the angle it
+  // reads back, as with a replay.
+  std::atomic<int32_t> tilt_degrees_ = {0};
+};
+
+}  // namespace pipe
+}  // namespace nui
+}  // namespace xe
+
+#endif  // XENIA_NUI_PIPE_PIPE_NUI_SYSTEM_H_
