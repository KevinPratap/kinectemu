+// Further than a Kinect reads, or behind it, is not a body in front of it.
+constexpr float kNearestBodyMetres = 0.3f;
+constexpr float kFarthestBodyMetres = 6.0f;
+constexpr float kLargestLateralMetres = 6.0f;
+
+bool IsPlausiblePoint(const float p[3]) {
+  return std::isfinite(p[0]) && std::isfinite(p[1]) && std::isfinite(p[2]) &&
+         p[2] >= kNearestBodyMetres && p[2] <= kFarthestBodyMetres &&
+         std::abs(p[0]) <= kLargestLateralMetres &&
+         std::abs(p[1]) <= kLargestLateralMetres;
+}
+
+// Pipe names are spelled by the user on the command line; anything outside
+// this set is refused rather than escaped, as for the depth pipe.
+bool IsValidPipeName(const std::string& name) {
+  return !name.empty() && name.size() <= 200 &&
+         std::all_of(name.begin(), name.end(), [](char c) {
+           return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+                  (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '.';
+         });
+}
+
+}  // namespace
+
+bool ReadSkeletonPipeRecord(const SkeletonPipeRecord& record,
+                            InjectedBody* body, bool* has_body,
+                            float floor_plane[4], bool* has_floor) {
+  *has_body = false;
+  *has_floor = false;
+  if (std::memcmp(record.magic, kSkeletonPipeMagic, sizeof(record.magic))) {
+    return false;
+  }
+  if (record.flags & kSkeletonPipeBody) {
+    if (!record.tracking_id || !IsPlausiblePoint(record.position)) {
+      return false;
+    }
+    InjectedBody read;
+    read.tracking_id = record.tracking_id;
+    read.position = {record.position[0], record.position[1], record.position[2],
+                     kInjectJointTracked};
+    for (uint32_t n = 0; n < kInjectJointCount; ++n) {
+      const uint32_t state = record.joint_states[n];
+      if (state > kInjectJointTracked ||
+          (state != kInjectJointNotTracked &&
+           !IsPlausiblePoint(record.joints[n]))) {
+        return false;
+      }
+      // A joint the writer did not place reads as zeros, as the runtime's
+      // own publisher leaves it.
+      read.joints[n] =
+          state == kInjectJointNotTracked
+              ? InjectedJoint()
+              : InjectedJoint{record.joints[n][0], record.joints[n][1],
+                              record.joints[n][2], state};
+    }
+    *body = read;
+    *has_body = true;
+  }
+  if (record.flags & kSkeletonPipeFloor) {
+    const float* f = record.floor_plane;
+    const float normal = std::sqrt(f[0] * f[0] + f[1] * f[1] + f[2] * f[2]);
+    if (!std::isfinite(normal) || !std::isfinite(f[3]) ||
+        std::abs(normal - 1.0f) > 0.01f || f[3] <= 0.0f ||
+        f[3] > kFarthestBodyMetres) {
+      *has_body = false;
+      return false;
+    }
+    std::copy(f, f + 4, floor_plane);
+    *has_floor = true;
+  }
+  return true;
+}
+
+void SkeletonPipe::Store(const SkeletonPipeRecord& record) {
+  std::lock_guard<std::mutex> lock(latest_mutex_);
+  latest_ = record;
+  latest_time_ = std::chrono::steady_clock::now();
+  has_latest_ = true;
+}
+
+bool SkeletonPipe::Latest(SkeletonPipeRecord* record,
+                          std::chrono::steady_clock::duration* age) const {
+  std::lock_guard<std::mutex> lock(latest_mutex_);
+  if (!has_latest_) {
+    return false;
+  }
+  *record = latest_;
+  *age = std::chrono::steady_clock::now() - latest_time_;
+  return true;
+}
+
+#if XE_PLATFORM_WIN32
+
+struct SkeletonPipe::Impl {
+  explicit Impl(SkeletonPipe* owner) : owner(owner) {}
+  ~Impl() {
+    ClosePipe();
+    if (io_event) {
+      CloseHandle(io_event);
+    }
+    if (shutdown_event) {
+      CloseHandle(shutdown_event);
+    }
+  }
+
+  void ClosePipe() {
+    if (pipe) {
+      DisconnectNamedPipe(pipe);
+      CloseHandle(pipe);
+      pipe = nullptr;
+    }
+  }
+
+  // Waits for the overlapped operation or for shutdown. False on shutdown or
+  // failure, with the operation cancelled.
+  bool Finish(OVERLAPPED* overlapped, DWORD* transferred) {
+    HANDLE handles[] = {shutdown_event, io_event};
+    if (WaitForMultipleObjects(2, handles, FALSE, INFINITE) !=
+        WAIT_OBJECT_0 + 1) {
+      CancelIoEx(pipe, overlapped);
+      GetOverlappedResult(pipe, overlapped, transferred, TRUE);
+      return false;
+    }
+    return GetOverlappedResult(pipe, overlapped, transferred, FALSE) != 0;
+  }
+
+  bool AcceptClient() {
+    // Single instance, inbound only, remote clients refused: poses come from
+    // this machine and go nowhere else.
+    pipe = CreateNamedPipeW(path.c_str(),
+                            PIPE_ACCESS_INBOUND | FILE_FLAG_OVERLAPPED |
+                                FILE_FLAG_FIRST_PIPE_INSTANCE,
+                            PIPE_TYPE_BYTE | PIPE_READMODE_BYTE | PIPE_WAIT |
+                                PIPE_REJECT_REMOTE_CLIENTS,
+                            1, 0, DWORD(64 * sizeof(SkeletonPipeRecord)), 0,
+                            nullptr);
+    if (pipe == INVALID_HANDLE_VALUE) {
+      pipe = nullptr;
+      XELOGE(
+          "NUI: could not create the skeleton pipe {} (error {}); is another "
+          "xenia already serving it?",
+          path_utf8, GetLastError());
+      return false;
+    }
+    OVERLAPPED overlapped = {};
+    overlapped.hEvent = io_event;
+    ResetEvent(io_event);
+    if (ConnectNamedPipe(pipe, &overlapped)) {
+      return true;
+    }
+    const DWORD error = GetLastError();
+    if (error == ERROR_PIPE_CONNECTED) {
+      return true;
+    }
+    if (error != ERROR_IO_PENDING) {
+      XELOGE("NUI: waiting for a skeleton writer failed (error {}).", error);
+      return false;
+    }
+    DWORD ignored;
+    return Finish(&overlapped, &ignored);
+  }
+
+  bool ReadExact(void* buffer, size_t size) {
+    auto* out = static_cast<uint8_t*>(buffer);
+    while (size) {
+      OVERLAPPED overlapped = {};
+      overlapped.hEvent = io_event;
+      ResetEvent(io_event);
+      DWORD read = 0;
+      if (!ReadFile(pipe, out, DWORD(size), &read, &overlapped)) {
+        if (GetLastError() != ERROR_IO_PENDING || !Finish(&overlapped, &read)) {
+          return false;
+        }
+      }
+      if (!read) {
+        return false;
+      }
+      out += read;
+      size -= read;
+    }
+    return true;
+  }
+
+  void Run() {
+    while (running.load(std::memory_order_acquire)) {
+      XELOGI("NUI: waiting for a skeleton writer on {}", path_utf8);
+      if (!AcceptClient()) {
+        ClosePipe();
+        break;
+      }
+      XELOGI("NUI: skeleton writer connected on {}", path_utf8);
+      owner->SetWriterConnected(true);
+      uint64_t records = 0, dropped = 0;
+      SkeletonPipeRecord record;
+      while (running.load(std::memory_order_acquire) &&
+             ReadExact(&record, sizeof(record))) {
+        InjectedBody body;
+        bool has_body, has_floor;
+        float floor[4];
+        if (!ReadSkeletonPipeRecord(record, &body, &has_body, floor,
+                                    &has_floor)) {
+          // A record that is not even framed right means the stream is out
+          // of step; a fresh connection is the only way back into it.
+          if (std::memcmp(record.magic, kSkeletonPipeMagic,
+                          sizeof(record.magic))) {
+            XELOGE(
+                "NUI: the skeleton writer on {} sent a record without the "
+                "{} magic; dropping it.",
+                path_utf8, std::string(kSkeletonPipeMagic, 8));
+            break;
+          }
+          if (dropped++ == 0) {
+            XELOGW(
+                "NUI: dropped a skeleton record that does not describe a "
+                "body in front of the sensor; later ones are counted.");
+          }
+          continue;
+        }
+        owner->Store(record);
+        ++records;
+      }
+      owner->SetWriterConnected(false);
+      if (running.load(std::memory_order_acquire)) {
+        XELOGI(
+            "NUI: skeleton writer on {} went away after {} records ({} "
+            "dropped)",
+            path_utf8, records, dropped);
+      }
+      ClosePipe();
+    }
+  }
+
+  SkeletonPipe* owner;
+  std::wstring path;
+  std::string path_utf8;
+  HANDLE pipe = nullptr;
+  HANDLE io_event = nullptr;
+  HANDLE shutdown_event = nullptr;
+  std::atomic<bool> running = {false};
+  std::unique_ptr<threading::Thread> thread;
+};
+
+SkeletonPipe::SkeletonPipe() = default;
+
+SkeletonPipe::~SkeletonPipe() { Stop(); }
+
+bool SkeletonPipe::Start(const std::string& name) {
+  Stop();
+  if (!IsValidPipeName(name)) {
+    XELOGE(
+        "NUI: \"{}\" is not a usable skeleton pipe name (letters, digits, - _ "
+        ". only).",
+        name);
+    return false;
+  }
+  auto impl = std::make_unique<Impl>(this);
+  impl->path_utf8 = "\\\\.\\pipe\\" + name;
+  // ASCII only (checked above), so widening char by char is exact.
+  impl->path = std::wstring(impl->path_utf8.begin(), impl->path_utf8.end());
+  impl->io_event = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+  impl->shutdown_event = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+  if (!impl->io_event || !impl->shutdown_event) {
+    XELOGE("NUI: failed to create the skeleton pipe's events.");
+    return false;
+  }
+  impl->running.store(true, std::memory_order_release);
+  Impl* raw = impl.get();
+  impl->thread = threading::Thread::Create({}, [raw]() { raw->Run(); });
+  if (!impl->thread) {
+    XELOGE("NUI: failed to start the skeleton pipe thread.");
+    return false;
+  }
+  impl->thread->set_name("NUI Skeleton Pipe");
+  impl_ = std::move(impl);
+  return true;
+}
+
+void SkeletonPipe::Stop() {
+  if (!impl_) {
+    return;
+  }
+  impl_->running.store(false, std::memory_order_release);
+  if (impl_->thread) {
+    // Every wait in the thread also waits on this event.
+    SetEvent(impl_->shutdown_event);
+    threading::Wait(impl_->thread.get(), false);
+  }
+  impl_.reset();
+  SetWriterConnected(false);
+}
+
+#else
+
+struct SkeletonPipe::Impl {};
+
+SkeletonPipe::SkeletonPipe() = default;
+SkeletonPipe::~SkeletonPipe() = default;
+
+bool SkeletonPipe::Start(const std::string& name) {
+  XELOGE("NUI: the skeleton pipe \"{}\" needs Windows named pipes.", name);
+  return false;
+}
+
+void SkeletonPipe::Stop() {}
+
+#endif  // XE_PLATFORM_WIN32
+
+}  // namespace nui
+}  // namespace xe
diff --git a/src/xenia/nui/nui_skeleton_pipe.h b/src/xenia/nui/nui_skeleton_pipe.h
new file mode 100644
index 0000000..1cb16c9
--- /dev/null
+++ b/src/xenia/nui/nui_skeleton_pipe.h
@@ -0,0 +1,105 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
