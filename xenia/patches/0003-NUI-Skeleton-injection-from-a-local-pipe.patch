+
+#ifndef XENIA_NUI_NUI_SKELETON_PIPE_H_
+#define XENIA_NUI_NUI_SKELETON_PIPE_H_
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <string>
+
+#include "xenia/nui/nui_skeleton_inject.h"
+
+namespace xe {
+namespace nui {
+
+// One skeleton as another process on this machine sends it for injection
+// (nui_skeleton_inject=pipe:<name>): a fixed-size record per tracker frame,
+// little endian like the .xdepth stream, already in the title's sensor space
+// (metres; x grows with the column of the depth image the title is given, y
+// up, z away from the sensor). Nothing in it reaches guest memory as it is.
+constexpr char kSkeletonPipeMagic[8] = {'X', 'N', 'U', 'I', 'S', 'K', 'L', '1'};
+
+struct SkeletonPipeRecord {
+  char magic[8];
+  // The writer's own clock; only logged.
+  uint64_t timestamp_us;
+  uint32_t flags;
+  // Never 0 when kSkeletonPipeBody is set.
+  uint32_t tracking_id;
+  float position[3];
+  uint32_t reserved;
+  float joints[kInjectJointCount][3];
+  // kInjectJointNotTracked, kInjectJointInferred or kInjectJointTracked.
+  uint32_t joint_states[kInjectJointCount];
+  // Floor clip plane: unit normal and the sensor's height above the floor in
+  // metres, used when kSkeletonPipeFloor is set.
+  float floor_plane[4];
+};
+static_assert(sizeof(SkeletonPipeRecord) == 376,
+              "The record is sent over the pipe as it is laid out.");
+
+constexpr uint32_t kSkeletonPipeBody = 1u << 0;
+constexpr uint32_t kSkeletonPipeFloor = 1u << 1;
+
+// Checks a record as it came off the pipe: the magic, a body with a tracking
+// id and finite coordinates in front of the sensor, joint states the runtime
+// knows, a floor with a unit normal. Fills body (when the record has one) and
+// floor_plane (when it has one) and returns false for anything else, so that
+// a malformed record is dropped rather than half-used.
+bool ReadSkeletonPipeRecord(const SkeletonPipeRecord& record,
+                            InjectedBody* body, bool* has_body,
+                            float floor_plane[4], bool* has_floor);
+
+// Serves \\.\pipe\<name> on a thread of its own and keeps the newest valid
+// record. Local clients only, one at a time; when the writer goes away the
+// pipe is offered again. Windows only: Start fails elsewhere.
+class SkeletonPipe {
+ public:
+  SkeletonPipe();
+  ~SkeletonPipe();
+
+  // Starts serving. Returns false, after logging why, when the name is not a
+  // usable pipe name or the pipe cannot be served.
+  bool Start(const std::string& name);
+  void Stop();
+
+  // The newest valid record and how long ago it arrived. False before the
+  // first one.
+  bool Latest(SkeletonPipeRecord* record,
+              std::chrono::steady_clock::duration* age) const;
+
+  bool writer_connected() const {
+    return writer_connected_.load(std::memory_order_acquire);
+  }
+
+ private:
+  struct Impl;
+  std::unique_ptr<Impl> impl_;
+
+  mutable std::mutex latest_mutex_;
+  bool has_latest_ = false;
+  SkeletonPipeRecord latest_ = {};
+  std::chrono::steady_clock::time_point latest_time_;
+  std::atomic<bool> writer_connected_ = {false};
+
+  // Called by the implementation's thread.
+  void Store(const SkeletonPipeRecord& record);
+  void SetWriterConnected(bool connected) {
+    writer_connected_.store(connected, std::memory_order_release);
+  }
+};
+
+}  // namespace nui
+}  // namespace xe
+
+#endif  // XENIA_NUI_NUI_SKELETON_PIPE_H_
diff --git a/src/xenia/nui/testing/nui_skeleton_site_test.cc b/src/xenia/nui/testing/nui_skeleton_site_test.cc
index 0561d90..c8afb82 100644
--- a/src/xenia/nui/testing/nui_skeleton_site_test.cc
+++ b/src/xenia/nui/testing/nui_skeleton_site_test.cc
@@ -11,10 +11,12 @@
 
 #include <algorithm>
 #include <cstring>
+#include <limits>
 #include <vector>
 
 #include "third_party/catch/include/catch.hpp"
 #include "xenia/nui/nui_skeleton_inject.h"
+#include "xenia/nui/nui_skeleton_pipe.h"
 
 namespace xe {
 namespace nui {
@@ -260,6 +262,88 @@ TEST_CASE("The test figure sways and jumps in front of the sensor",
   CHECK(rest.tracking_id != 0);
 }
 
+namespace {
+
+SkeletonPipeRecord StandingRecord() {
+  SkeletonPipeRecord record = {};
+  std::memcpy(record.magic, kSkeletonPipeMagic, sizeof(record.magic));
+  record.flags = kSkeletonPipeBody | kSkeletonPipeFloor;
+  record.tracking_id = 3;
+  const InjectedBody body = MakeTestPatternBody(0.0);
+  record.position[0] = body.position.x;
+  record.position[1] = body.position.y;
+  record.position[2] = body.position.z;
+  for (uint32_t n = 0; n < kInjectJointCount; ++n) {
+    record.joints[n][0] = body.joints[n].x;
+    record.joints[n][1] = body.joints[n].y;
+    record.joints[n][2] = body.joints[n].z;
+    record.joint_states[n] = kInjectJointTracked;
+  }
+  record.floor_plane[1] = 1.0f;
+  record.floor_plane[3] = 0.9f;
+  return record;
+}
+
+}  // namespace
+
+TEST_CASE("A skeleton pipe record becomes a body and a floor",
+          "[nui][skeleton]") {
+  SkeletonPipeRecord record = StandingRecord();
+  record.joint_states[kInjectHandLeft] = kInjectJointInferred;
+  record.joint_states[kInjectFootRight] = kInjectJointNotTracked;
+  record.joints[kInjectFootRight][2] = 0.0f;  // unplaced, so not checked
+  InjectedBody body;
+  bool has_body, has_floor;
+  float floor[4];
+  REQUIRE(ReadSkeletonPipeRecord(record, &body, &has_body, floor, &has_floor));
+  CHECK(has_body);
+  CHECK(has_floor);
+  CHECK(body.tracking_id == 3);
+  CHECK(body.position.z == Approx(2.2f));
+  CHECK(body.joints[kInjectHead].y == Approx(record.joints[kInjectHead][1]));
+  CHECK(body.joints[kInjectHandLeft].tracking_state == kInjectJointInferred);
+  CHECK(body.joints[kInjectFootRight].tracking_state == kInjectJointNotTracked);
+  CHECK(body.joints[kInjectFootRight].y == 0.0f);
+  CHECK(floor[1] == 1.0f);
+  CHECK(floor[3] == Approx(0.9f));
+
+  // No body and no floor is a valid record: nobody in view.
+  record.flags = 0;
+  REQUIRE(ReadSkeletonPipeRecord(record, &body, &has_body, floor, &has_floor));
+  CHECK_FALSE(has_body);
+  CHECK_FALSE(has_floor);
+}
+
+TEST_CASE("A skeleton pipe record that is not a body in view is refused",
+          "[nui][skeleton]") {
+  InjectedBody body;
+  bool has_body, has_floor;
+  float floor[4];
+  auto refused = [&](SkeletonPipeRecord record) {
+    return !ReadSkeletonPipeRecord(record, &body, &has_body, floor,
+                                   &has_floor) &&
+           !has_body && !has_floor;
+  };
+  SkeletonPipeRecord record = StandingRecord();
+  record.magic[7] = '2';
+  CHECK(refused(record));
+  record = StandingRecord();
+  record.tracking_id = 0;
+  CHECK(refused(record));
+  record = StandingRecord();
+  record.joints[kInjectHead][2] = -1.0f;  // behind the sensor
+  CHECK(refused(record));
+  record = StandingRecord();
+  record.joints[kInjectHandRight][0] = std::numeric_limits<float>::quiet_NaN();
+  CHECK(refused(record));
+  record = StandingRecord();
+  record.joint_states[kInjectSpine] = 7;
+  CHECK(refused(record));
+  record = StandingRecord();
+  record.floor_plane[1] = 0.5f;  // not a unit normal
+  CHECK(refused(record));
+}
