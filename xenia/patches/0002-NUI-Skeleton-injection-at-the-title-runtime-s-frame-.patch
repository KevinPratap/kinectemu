+void StoreU32(uint8_t* at, uint32_t value) {
+  at[0] = uint8_t(value >> 24);
+  at[1] = uint8_t(value >> 16);
+  at[2] = uint8_t(value >> 8);
+  at[3] = uint8_t(value);
+}
+
+void StoreF32(uint8_t* at, float value) {
+  uint32_t bits;
+  std::memcpy(&bits, &value, sizeof(bits));
+  StoreU32(at, bits);
+}
+
+void StorePoint(uint8_t* at, const InjectedJoint& joint) {
+  StoreF32(at + 0, joint.x);
+  StoreF32(at + 4, joint.y);
+  StoreF32(at + 8, joint.z);
+  StoreF32(at + 12, 1.0f);
+}
+
+constexpr size_t kEnrollmentIndexOffset = 0x08;
+constexpr size_t kIdentityWordsBytes = 8;
+constexpr size_t kPositionOffset = 0x10;
+constexpr size_t kJointPositionsOffset = 0x20;
+constexpr size_t kJointStatesOffset = 0x160;
+
+void EmptySlot(uint8_t* skeleton) {
+  uint8_t identity[kIdentityWordsBytes];
+  std::memcpy(identity, skeleton + kEnrollmentIndexOffset, sizeof(identity));
+  std::memset(skeleton, 0, kInjectSkeletonDataBytes);
+  std::memcpy(skeleton + kEnrollmentIndexOffset, identity, sizeof(identity));
+}
+
+// The figure's joints relative to its hip centre, in metres, standing upright
+// and facing the sensor with its arms a little away from its sides.
+constexpr float kRestPose[kInjectJointCount][3] = {
+    {0.00f, 0.00f, 0.00f},     // hip centre
+    {0.00f, 0.10f, 0.00f},     // spine
+    {0.00f, 0.45f, 0.00f},     // shoulder centre
+    {0.00f, 0.62f, 0.00f},     // head
+    {-0.18f, 0.42f, 0.00f},    // shoulder left
+    {-0.30f, 0.18f, 0.00f},    // elbow left
+    {-0.34f, -0.05f, 0.00f},   // wrist left
+    {-0.35f, -0.12f, 0.00f},   // hand left
+    {0.18f, 0.42f, 0.00f},     // shoulder right
+    {0.30f, 0.18f, 0.00f},     // elbow right
+    {0.34f, -0.05f, 0.00f},    // wrist right
+    {0.35f, -0.12f, 0.00f},    // hand right
+    {-0.09f, -0.05f, 0.00f},   // hip left
+    {-0.10f, -0.45f, 0.00f},   // knee left
+    {-0.10f, -0.83f, 0.00f},   // ankle left
+    {-0.10f, -0.88f, -0.08f},  // foot left
+    {0.09f, -0.05f, 0.00f},    // hip right
+    {0.10f, -0.45f, 0.00f},    // knee right
+    {0.10f, -0.83f, 0.00f},    // ankle right
+    {0.10f, -0.88f, -0.08f},   // foot right
+};
+
+}  // namespace
+
+void WriteInjectedSkeletons(uint8_t* frame, const InjectedBody* body,
+                            uint32_t slot) {
+  for (uint32_t n = 0; n < kInjectSkeletonCount; ++n) {
+    EmptySlot(frame + kInjectSkeletonDataOffset + n * kInjectSkeletonDataBytes);
+  }
+  if (!body || slot >= kInjectSkeletonCount || !body->tracking_id) {
+    return;
+  }
+  uint8_t* skeleton =
+      frame + kInjectSkeletonDataOffset + slot * kInjectSkeletonDataBytes;
+  StoreU32(skeleton + 0, kInjectSkeletonTracked);
+  StoreU32(skeleton + 4, body->tracking_id);
+  StorePoint(skeleton + kPositionOffset, body->position);
+  for (uint32_t n = 0; n < kInjectJointCount; ++n) {
+    StorePoint(skeleton + kJointPositionsOffset + n * 16, body->joints[n]);
+    StoreU32(skeleton + kJointStatesOffset + n * 4,
+             body->joints[n].tracking_state);
+  }
+}
+
+InjectedBody MakeTestPatternBody(double seconds) {
+  constexpr double kPi = 3.14159265358979323846;
+  constexpr double kSwayPeriod = 6.0, kSwayAmplitude = 0.35;
+  constexpr double kJumpPeriod = 4.0, kJumpLength = 0.5, kJumpHeight = 0.25;
+  constexpr float kDistance = 2.2f;
+  const double sway =
+      kSwayAmplitude * std::sin(2.0 * kPi * seconds / kSwayPeriod);
+  // A parabola from take-off to landing in the first half second of each
+  // jump period.
+  const double in_jump = std::fmod(seconds, kJumpPeriod);
+  double lift = 0.0;
+  if (in_jump >= 0.0 && in_jump < kJumpLength) {
+    const double u = in_jump / kJumpLength;
+    lift = 4.0 * kJumpHeight * u * (1.0 - u);
+  }
+  InjectedBody body;
+  for (uint32_t n = 0; n < kInjectJointCount; ++n) {
+    body.joints[n] = {static_cast<float>(kRestPose[n][0] + sway),
+                      static_cast<float>(kRestPose[n][1] + lift),
+                      kRestPose[n][2] + kDistance, kInjectJointTracked};
+  }
+  body.position = body.joints[kInjectHipCenter];
+  return body;
+}
+
+}  // namespace nui
+}  // namespace xe
