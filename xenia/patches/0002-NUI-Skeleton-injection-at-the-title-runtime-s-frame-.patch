+namespace {
+
+uint32_t LoadU32(const uint8_t* at) {
+  return uint32_t(at[0]) << 24 | uint32_t(at[1]) << 16 | uint32_t(at[2]) << 8 |
+         uint32_t(at[3]);
+}
+
+float LoadF32(const uint8_t* at) {
+  const uint32_t bits = LoadU32(at);
+  float value;
+  std::memcpy(&value, &bits, sizeof(value));
+  return value;
+}
+
+uint8_t* Slot(std::vector<uint8_t>& frame, uint32_t n) {
+  return frame.data() + kInjectSkeletonDataOffset +
+         n * kInjectSkeletonDataBytes;
+}
+
+}  // namespace
+
+TEST_CASE("An injected body replaces the tracker's skeletons in place",
+          "[nui][skeleton]") {
+  std::vector<uint8_t> frame(kSkeletonFrameBytes, 0xCD);
+  const std::vector<uint8_t> header(frame.begin(),
+                                    frame.begin() + kInjectSkeletonDataOffset);
+  InjectedBody body = MakeTestPatternBody(0.0);
+  body.tracking_id = 7;
+  WriteInjectedSkeletons(frame.data(), &body, 1);
+
+  // The header is the runtime's.
+  CHECK(std::equal(header.begin(), header.end(), frame.begin()));
+  for (uint32_t n = 0; n < kInjectSkeletonCount; ++n) {
+    const uint8_t* skeleton = Slot(frame, n);
+    // The identity pass's two words survive in every slot.
+    CHECK(LoadU32(skeleton + 8) == 0xCDCDCDCD);
+    CHECK(LoadU32(skeleton + 12) == 0xCDCDCDCD);
+    if (n != 1) {
+      CHECK(LoadU32(skeleton) == kInjectSkeletonNotTracked);
+      CHECK(LoadU32(skeleton + 4) == 0);
+      CHECK(LoadU32(skeleton + 0x20) == 0);
+      CHECK(LoadU32(skeleton + 0x1B0) == 0);
+    }
+  }
+  const uint8_t* skeleton = Slot(frame, 1);
+  CHECK(LoadU32(skeleton) == kInjectSkeletonTracked);
+  CHECK(LoadU32(skeleton + 4) == 7);
+  CHECK(LoadF32(skeleton + 0x10 + 8) == Approx(2.2f));
+  const uint8_t* head = skeleton + 0x20 + kInjectHead * 16;
+  CHECK(LoadF32(head + 4) == Approx(body.joints[kInjectHead].y));
+  CHECK(LoadF32(head + 12) == 1.0f);
+  CHECK(LoadU32(skeleton + 0x160 + kInjectHandRight * 4) ==
+        kInjectJointTracked);
+  CHECK(LoadU32(skeleton + 0x1B0) == 0);
+}
+
+TEST_CASE("Without a body every skeleton slot is emptied", "[nui][skeleton]") {
+  std::vector<uint8_t> frame(kSkeletonFrameBytes, 0xCD);
+  WriteInjectedSkeletons(frame.data(), nullptr, 0);
+  for (uint32_t n = 0; n < kInjectSkeletonCount; ++n) {
+    CHECK(LoadU32(Slot(frame, n)) == kInjectSkeletonNotTracked);
+  }
+  // A body with no id is no body.
+  InjectedBody body = MakeTestPatternBody(0.0);
+  body.tracking_id = 0;
+  std::fill(frame.begin(), frame.end(), 0xCD);
+  WriteInjectedSkeletons(frame.data(), &body, 0);
+  CHECK(LoadU32(Slot(frame, 0)) == kInjectSkeletonNotTracked);
+}
+
+TEST_CASE("The test figure sways and jumps in front of the sensor",
+          "[nui][skeleton]") {
+  const InjectedBody rest = MakeTestPatternBody(0.0);
+  const InjectedBody right = MakeTestPatternBody(1.5);
+  const InjectedBody jump = MakeTestPatternBody(4.25);
+  CHECK(rest.joints[kInjectHipCenter].x == Approx(0.0f).margin(1e-6));
+  CHECK(right.joints[kInjectHipCenter].x == Approx(0.35f));
+  // A quarter of the sway period and a quarter of a jump in: the jump is at
+  // its top.
+  CHECK(jump.joints[kInjectHead].y - rest.joints[kInjectHead].y ==
+        Approx(0.25f));
+  CHECK(rest.joints[kInjectHandRight].x > rest.joints[kInjectHandLeft].x);
+  CHECK(rest.joints[kInjectHead].y > rest.joints[kInjectFootLeft].y);
+  for (const InjectedJoint& joint : rest.joints) {
+    CHECK(joint.z > 2.0f);
+    CHECK(joint.tracking_state == kInjectJointTracked);
+  }
+  CHECK(rest.tracking_id != 0);
+}
