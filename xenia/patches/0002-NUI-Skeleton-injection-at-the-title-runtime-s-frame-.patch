+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Copyright 2026 Xenia Canary. All rights reserved.                          *
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ */
+
+#ifndef XENIA_NUI_NUI_SKELETON_INJECT_H_
+#define XENIA_NUI_NUI_SKELETON_INJECT_H_
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+namespace xe {
+namespace nui {
+
+// The NUI_SKELETON_FRAME layout of runtime 2.0.11775, big-endian:
+//   +0x00 u64 timestamp   +0x08 u32 frame number   +0x0C u32 flags
+//   +0x10 floor clip plane (4 floats)   +0x20 normal to gravity (4 floats)
+//   +0x30 six 0x1C0-byte NUI_SKELETON_DATA
+// and in each skeleton:
+//   +0x000 tracking state   +0x004 tracking id
+//   +0x008 enrollment index +0x00C user index   (written by the identity pass)
+//   +0x010 position (4 floats)   +0x020 twenty joint positions (4 floats each)
+//   +0x160 twenty joint tracking states   +0x1B0 quality flags
+inline constexpr size_t kInjectSkeletonDataOffset = 0x30;
+inline constexpr size_t kInjectSkeletonDataBytes = 0x1C0;
+inline constexpr uint32_t kInjectSkeletonCount = 6;
+inline constexpr uint32_t kInjectJointCount = 20;
+
+inline constexpr uint32_t kInjectSkeletonNotTracked = 0;
+inline constexpr uint32_t kInjectSkeletonTracked = 2;
+inline constexpr uint32_t kInjectJointNotTracked = 0;
+inline constexpr uint32_t kInjectJointInferred = 1;
+inline constexpr uint32_t kInjectJointTracked = 2;
+
+// Joint order of the public NUI skeleton.
+enum InjectJoint : uint32_t {
+  kInjectHipCenter = 0,
+  kInjectSpine,
+  kInjectShoulderCenter,
+  kInjectHead,
+  kInjectShoulderLeft,
+  kInjectElbowLeft,
+  kInjectWristLeft,
+  kInjectHandLeft,
+  kInjectShoulderRight,
+  kInjectElbowRight,
+  kInjectWristRight,
+  kInjectHandRight,
+  kInjectHipLeft,
+  kInjectKneeLeft,
+  kInjectAnkleLeft,
+  kInjectFootLeft,
+  kInjectHipRight,
+  kInjectKneeRight,
+  kInjectAnkleRight,
+  kInjectFootRight,
+};
+
+// A joint in the sensor's camera space, in metres: x to the right of the
+// image the sensor sees mirrored (a facing player's right hand has the larger
+// x), y up, z away from the sensor.
+struct InjectedJoint {
+  float x = 0.0f;
+  float y = 0.0f;
+  float z = 0.0f;
+  uint32_t tracking_state = kInjectJointNotTracked;
+};
+
+struct InjectedBody {
+  // Never 0: the runtime and the title read id 0 as "no skeleton".
+  uint32_t tracking_id = 1;
+  // The skeleton's own position; the runtime's tracker puts it near the hip.
+  InjectedJoint position;
+  std::array<InjectedJoint, kInjectJointCount> joints;
+};
+
+// Rewrites the six skeleton slots of a NUI_SKELETON_FRAME in place. With a
+// body, `slot` holds it as tracked and every other slot is emptied; without
+// one, every slot is emptied. An emptied slot reads as the runtime's own
+// publisher leaves an unused one, all zero, except that in every slot the
+// enrollment index and user index words are kept as the runtime wrote them,
+// since they are the identity pass's and not the tracker's. The frame header
+// (timestamp, frame number, flags, floor plane, gravity) is not touched.
+void WriteInjectedSkeletons(uint8_t* frame, const InjectedBody* body,
+                            uint32_t slot);
+
+// A synthetic test body for checking the injection path without a camera: a
+// standing figure 2.2 m from the sensor that sways 0.35 m to either side over
+// six seconds and jumps 0.25 m every four. It is not anyone's pose.
+InjectedBody MakeTestPatternBody(double seconds);
+
+}  // namespace nui
+}  // namespace xe
+
+#endif  // XENIA_NUI_NUI_SKELETON_INJECT_H_
diff --git a/src/xenia/nui/nui_skeleton_site.cc b/src/xenia/nui/nui_skeleton_site.cc
new file mode 100644
index 0000000..192c746
--- /dev/null
+++ b/src/xenia/nui/nui_skeleton_site.cc
@@ -0,0 +1,288 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Copyright 2026 Xenia Canary. All rights reserved.                          *
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ */
+
+#include "xenia/nui/nui_skeleton_site.h"
+
+#include <algorithm>
+#include <vector>
+
+namespace xe {
+namespace nui {
+
+namespace {
+
+// Instruction fields, PowerPC numbering from the most significant bit.
+uint32_t Opcode(uint32_t w) { return w >> 26; }
+uint32_t FieldD(uint32_t w) { return (w >> 21) & 31; }
+uint32_t FieldA(uint32_t w) { return (w >> 16) & 31; }
+uint32_t Imm16(uint32_t w) { return w & 0xFFFF; }
+int32_t Simm16(uint32_t w) { return static_cast<int16_t>(w & 0xFFFF); }
+
+constexpr uint32_t kOpMulli = 7;
+constexpr uint32_t kOpCmpli = 10;
+constexpr uint32_t kOpAddi = 14;
+constexpr uint32_t kOpAddis = 15;
+constexpr uint32_t kOpBranch = 18;
+constexpr uint32_t kOpOri = 24;
+constexpr uint32_t kOpLwz = 32;
+
+constexpr uint32_t kMflrR12 = 0x7D8802A6;
+constexpr uint32_t kLiR5FrameBytes = 0x38A00000 | kSkeletonFrameBytes;
+constexpr uint32_t kBctr = 0x4E800420;
+// How far from its prologue NuiSkeletonGetNextFrame does the things that
+// identify it; the function is 0x1F0 bytes long in 4D5308ED.
+constexpr uint32_t kGetNextFrameSpan = 0x280;
+// The callback pointer lives in the runtime's state block, 0x28EC bytes in
+// for 4D5308ED; anything beyond this is not that block.
+constexpr uint32_t kRuntimeStateSpan = 0x10000;
+
+class Code {
+ public:
+  Code(const uint8_t* image, size_t size, uint32_t base)
+      : image_(image), words_(size / 4), base_(base) {}
+  size_t words() const { return words_; }
+  uint32_t address(size_t index) const {
+    return base_ + static_cast<uint32_t>(index * 4);
+  }
+  uint32_t at(size_t index) const {
+    const uint8_t* p = image_ + index * 4;
+    return uint32_t(p[0]) << 24 | uint32_t(p[1]) << 16 | uint32_t(p[2]) << 8 |
+           uint32_t(p[3]);
+  }
+
+ private:
+  const uint8_t* image_;
+  size_t words_;
+  uint32_t base_;
+};
+
+// The signature PS5X360 uses for NuiSkeletonGetNextFrame (title 4E4D084E):
+// a function that copies one 0xAB0-byte frame, clamps its wait to 8000 ms,
+// turns milliseconds into 100 ns units and can answer 0x8007048F ("device
+// not connected"). Registers differ between builds, so only opcodes and
+// constants are compared.
+std::vector<size_t> FindGetNextFrame(const Code& code) {
+  std::vector<size_t> found;
+  const size_t span = kGetNextFrameSpan / 4;
+  for (size_t i = 0; i < code.words(); ++i) {
+    if (code.at(i) != kLiR5FrameBytes) {
+      continue;
+    }
+    size_t start = i;
+    while (start > 0 && i - start < span && code.at(start) != kMflrR12) {
+      --start;
+    }
+    if (code.at(start) != kMflrR12) {
+      continue;
+    }
+    bool wait_limit = false, to_ticks = false, not_connected = false;
+    for (size_t n = start; n < start + span && n < code.words(); ++n) {
+      const uint32_t w = code.at(n);
+      wait_limit |=
+          Opcode(w) == kOpCmpli && FieldA(w) == 3 && Imm16(w) == 0x1F40;
+      to_ticks |= Opcode(w) == kOpMulli && Imm16(w) == 0xD8F0;
+      not_connected |= Opcode(w) == kOpOri && Imm16(w) == 0x048F;
+    }
+    if (wait_limit && to_ticks && not_connected &&
+        (found.empty() || found.back() != start)) {
+      found.push_back(start);
+    }
+  }
+  return found;
+}
+
+// Reads g and the slot geometry out of NuiSkeletonGetNextFrame:
+//   lis rA, hi ; ... ; addi rG, rA, lo           g = hi << 16 + lo
+//   addi rR, rG, ring ; mulli rI, rI, stride     slot = g + ring + i * stride
+//   li r5, 0xAB0 ; addi r4, rS, frame            source = slot + frame
+bool ReadGetNextFrame(const Code& code, size_t start, SkeletonFrameSite* site) {
+  const size_t end = std::min(code.words(), start + kGetNextFrameSpan / 4);
+  uint32_t g_register = 32;
+  for (size_t n = start; n < end && g_register == 32; ++n) {
+    const uint32_t lis = code.at(n);
+    if (Opcode(lis) != kOpAddis || FieldA(lis) != 0) {
+      continue;
+    }
+    for (size_t k = n + 1; k < end && k <= n + 8; ++k) {
+      const uint32_t addi = code.at(k);
+      if (Opcode(addi) == kOpAddi && FieldA(addi) == FieldD(lis)) {
+        site->runtime_state = (Imm16(lis) << 16) + Simm16(addi);
+        g_register = FieldD(addi);
+        break;
+      }
+    }
+  }
+  if (g_register == 32) {
+    return false;
+  }
+  bool ring = false, frame = false;
+  for (size_t n = start; n < end; ++n) {
+    const uint32_t w = code.at(n);
+    if (!ring && Opcode(w) == kOpMulli && Simm16(w) > 0) {
+      for (size_t k = n; k > start && k + 4 > n; --k) {
+        const uint32_t addi = code.at(k - 1);
+        if (Opcode(addi) == kOpAddi && FieldA(addi) == g_register &&
+            Simm16(addi) > 0) {
+          site->slot_ring_offset = Imm16(addi);
+          site->slot_stride = Imm16(w);
+          ring = true;
+          break;
+        }
+      }
+    }
+    if (!frame && w == kLiR5FrameBytes) {
+      for (size_t k = n + 1; k < end && k <= n + 4; ++k) {
+        const uint32_t addi = code.at(k);
+        if (Opcode(addi) == kOpAddi && FieldD(addi) == 4 && Simm16(addi) >= 0) {
+          site->slot_frame_offset = Imm16(addi);
+          frame = true;
+          break;
+        }
+      }
+    }
+  }
+  return ring && frame &&
+         site->slot_frame_offset + kSkeletonFrameBytes <= site->slot_stride;
+}
+
+// lis rX, hi ; lwz rY, lo(rX) ; cmplwi crN, rY, 0 ; beqlr crN ; mtctr rY ;
+// bctr, calling through a pointer inside the runtime's state block.
+bool IsFrameCallbackThunk(const Code& code, size_t i, uint32_t runtime_state,
+                          uint32_t* pointer) {
+  if (i + 6 > code.words()) {
+    return false;
+  }
+  const uint32_t lis = code.at(i), lwz = code.at(i + 1), cmp = code.at(i + 2),
+                 beqlr = code.at(i + 3), mtctr = code.at(i + 4),
+                 bctr = code.at(i + 5);
+  if (Opcode(lis) != kOpAddis || FieldA(lis) != 0 || Opcode(lwz) != kOpLwz ||
+      FieldA(lwz) != FieldD(lis) || bctr != kBctr) {
+    return false;
+  }
+  const uint32_t value = FieldD(lwz);
+  const uint32_t cr_field = FieldD(cmp) >> 2;
+  // cmplwi crN, rY, 0 is cmpli with L = 0.
+  if (Opcode(cmp) != kOpCmpli || (FieldD(cmp) & 3) != 0 ||
+      FieldA(cmp) != value || Imm16(cmp) != 0) {
+    return false;
+  }
+  // beqlr crN: bclr 12, 4 * N + 2.
+  if (beqlr != (0x4D800020 | (cr_field * 4 + 2) << 16)) {
+    return false;
+  }
+  // mtctr rY: mtspr 9, rY.
+  if (mtctr != (0x7C0903A6 | value << 21)) {
+    return false;
+  }
+  const uint32_t target = (Imm16(lis) << 16) + Simm16(lwz);
+  if (target < runtime_state || target - runtime_state >= kRuntimeStateSpan) {
+    return false;
+  }
+  *pointer = target;
+  return true;
+}
+
+std::vector<size_t> FindCallsTo(const Code& code, uint32_t target) {
+  std::vector<size_t> calls;
+  for (size_t i = 0; i < code.words(); ++i) {
+    const uint32_t w = code.at(i);
+    // bl: I-form, AA = 0, LK = 1.
+    if (Opcode(w) != kOpBranch || (w & 3) != 1) {
+      continue;
+    }
+    int32_t offset = static_cast<int32_t>(w & 0x03FFFFFC);
+    if (offset & 0x02000000) {
+      offset -= 0x04000000;
+    }
+    if (code.address(i) + static_cast<uint32_t>(offset) == target) {
+      calls.push_back(i);
+    }
+  }
+  return calls;
+}
+
+}  // namespace
+
+bool SkeletonFrameSite::IsSlotFrame(uint32_t frame) const {
+  for (uint32_t slot = 0; slot < kSkeletonFrameSlotCount; ++slot) {
+    if (frame == runtime_state + slot_ring_offset + slot * slot_stride +
+                     slot_frame_offset) {
+      return true;
+    }
+  }
+  return false;
+}
+
+std::string_view SkeletonSiteStatusName(SkeletonSiteStatus status) {
+  switch (status) {
+    case SkeletonSiteStatus::kFound:
+      return "found";
+    case SkeletonSiteStatus::kNoGetNextFrame:
+      return "no NuiSkeletonGetNextFrame";
+    case SkeletonSiteStatus::kAmbiguousGetNextFrame:
+      return "more than one NuiSkeletonGetNextFrame";
+    case SkeletonSiteStatus::kUnreadableGetNextFrame:
+      return "NuiSkeletonGetNextFrame does not name its state block and slots";
+    case SkeletonSiteStatus::kNoFrameCallback:
+      return "no frame callback thunk into the state block";
+    case SkeletonSiteStatus::kAmbiguousFrameCallback:
+      return "more than one frame callback thunk into the state block";
+    case SkeletonSiteStatus::kFrameCallbackNotCalledOnce:
+      return "the frame callback thunk is not called exactly once";
+  }
+  return "unknown";
+}
+
+SkeletonSiteStatus FindSkeletonFrameSite(const uint8_t* image, size_t size,
+                                         uint32_t base, SkeletonFrameSite* out,
+                                         size_t* found_count) {
+  const Code code(image, size, base);
+  size_t unused_count;
+  size_t& count = found_count ? *found_count : unused_count;
+  SkeletonFrameSite site;
+
+  const std::vector<size_t> get_next_frame = FindGetNextFrame(code);
+  count = get_next_frame.size();
+  if (get_next_frame.size() != 1) {
+    return get_next_frame.empty() ? SkeletonSiteStatus::kNoGetNextFrame
+                                  : SkeletonSiteStatus::kAmbiguousGetNextFrame;
+  }
+  site.get_next_frame = code.address(get_next_frame[0]);
+  if (!ReadGetNextFrame(code, get_next_frame[0], &site)) {
+    return SkeletonSiteStatus::kUnreadableGetNextFrame;
+  }
+
+  std::vector<size_t> thunks;
+  for (size_t i = 0; i < code.words(); ++i) {
+    uint32_t pointer;
+    if (IsFrameCallbackThunk(code, i, site.runtime_state, &pointer)) {
+      thunks.push_back(i);
+      site.frame_callback_pointer = pointer;
+    }
+  }
+  count = thunks.size();
+  if (thunks.size() != 1) {
+    return thunks.empty() ? SkeletonSiteStatus::kNoFrameCallback
+                          : SkeletonSiteStatus::kAmbiguousFrameCallback;
+  }
+  site.frame_callback = code.address(thunks[0]);
+
+  const std::vector<size_t> calls = FindCallsTo(code, site.frame_callback);
+  count = calls.size();
+  if (calls.size() != 1) {
+    return SkeletonSiteStatus::kFrameCallbackNotCalledOnce;
+  }
+  site.frame_callback_call = code.address(calls[0]);
+  count = 1;
+  *out = site;
+  return SkeletonSiteStatus::kFound;
+}
+
+}  // namespace nui
+}  // namespace xe
diff --git a/src/xenia/nui/nui_skeleton_site.h b/src/xenia/nui/nui_skeleton_site.h
new file mode 100644
index 0000000..4b24d6b
--- /dev/null
+++ b/src/xenia/nui/nui_skeleton_site.h
@@ -0,0 +1,88 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Copyright 2026 Xenia Canary. All rights reserved.                          *
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ */
+
+#ifndef XENIA_NUI_NUI_SKELETON_SITE_H_
+#define XENIA_NUI_NUI_SKELETON_SITE_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <string_view>
+
+namespace xe {
+namespace nui {
+
+// Where a title's statically linked NUI runtime builds and hands out its
+// skeleton frames, found in the title's code by what the code does rather
+// than by fixed addresses, so that two builds of one title (two disc
+// revisions of 4D5308ED differ by up to 0x1000 bytes in this region) are both
+// found. All addresses are guest virtual addresses.
+//
+// The runtime fills one of two 0xAE0-byte slots per depth frame; a slot holds
+// a state word at +0 and the 0xAB0-byte NUI_SKELETON_FRAME at +0x20. Once the
+// frame is complete, and before the slot is published to
+// NuiSkeletonGetNextFrame and copied to the HUD message 0x2B002, the producer
+// calls a small thunk that calls through a function pointer in the runtime's
+// state block when it is not null:
+//
+//   lis rX, hi ; lwz rY, lo(rX) ; cmplwi crN, rY, 0 ; beqlr crN ;
+//   mtctr rY ; bctr
+//
+// That thunk is the point at which a skeleton supplied by the host can stand
+// in for the tracker's, for every consumer of the frame at once.
+struct SkeletonFrameSite {
+  // NuiSkeletonGetNextFrame(wait_ms, NUI_SKELETON_FRAME*).
+  uint32_t get_next_frame = 0;
+  // The runtime's state block (g), as NuiSkeletonGetNextFrame addresses it.
+  uint32_t runtime_state = 0;
+  // Offset of the slot ring in g, the size of one slot and the offset of the
+  // NUI_SKELETON_FRAME in a slot, as NuiSkeletonGetNextFrame reads them.
+  uint32_t slot_ring_offset = 0;
+  uint32_t slot_stride = 0;
+  uint32_t slot_frame_offset = 0;
+  // The thunk that hands the finished frame to the optional callback, the
+  // pointer it calls through and the one call to it in the frame producer.
+  uint32_t frame_callback = 0;
+  uint32_t frame_callback_pointer = 0;
+  uint32_t frame_callback_call = 0;
+
+  // Returns whether frame is the NUI_SKELETON_FRAME of one of the two slots.
+  bool IsSlotFrame(uint32_t frame) const;
+};
+
+enum class SkeletonSiteStatus {
+  kFound,
+  kNoGetNextFrame,
+  kAmbiguousGetNextFrame,
+  kUnreadableGetNextFrame,
+  kNoFrameCallback,
+  kAmbiguousFrameCallback,
+  kFrameCallbackNotCalledOnce,
+};
+
+std::string_view SkeletonSiteStatusName(SkeletonSiteStatus status);
+
+// Number of NUI_SKELETON_FRAME slots the runtime alternates between.
+inline constexpr uint32_t kSkeletonFrameSlotCount = 2;
+// sizeof(NUI_SKELETON_FRAME) in this runtime; NuiSkeletonGetNextFrame copies
+// exactly this many bytes.
+inline constexpr uint32_t kSkeletonFrameBytes = 0xAB0;
+
+// Searches the loaded image (code is big-endian PowerPC, image[0] at base)
+// for the site above. Every step requires exactly one match and the result
+// says which step failed otherwise; nothing is guessed. found_count, when
+// given, receives the number of candidates of the step that decided the
+// result.
+SkeletonSiteStatus FindSkeletonFrameSite(const uint8_t* image, size_t size,
+                                         uint32_t base, SkeletonFrameSite* out,
+                                         size_t* found_count = nullptr);
+
+}  // namespace nui
+}  // namespace xe
+
+#endif  // XENIA_NUI_NUI_SKELETON_SITE_H_
