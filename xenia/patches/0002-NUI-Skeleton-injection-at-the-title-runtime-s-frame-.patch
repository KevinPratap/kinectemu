+void NuiState::BindSkeletonInjection() {
+  const std::string source = cvars::nui_skeleton_inject;
+  if (source.empty()) {
+    return;
+  }
+  std::lock_guard<std::mutex> lock(skeleton_inject_mutex_);
+  if (skeleton_inject_tried_) {
+    return;
+  }
+  skeleton_inject_tried_ = true;
+  if (source != "test") {
+    XELOGW(
+        "NUI: nui_skeleton_inject \"{}\" is not a skeleton source xenia has "
+        "(\"test\"); the title keeps its own tracker's skeletons.",
+        source);
+    return;
+  }
+  auto module = kernel_state_->GetExecutableModule();
+  cpu::XexModule* xex = module ? module->xex_module() : nullptr;
+  if (!xex) {
+    XELOGW("NUI: skeleton injection: the title has no XEX image to search.");
+    return;
+  }
+  const uint32_t base = xex->base_address();
+  const uint32_t size = xex->image_size();
+  if (!IsGuestRangeReadable(base, size)) {
+    XELOGW(
+        "NUI: skeleton injection: the title's image {:08X}+{:08X} is not all "
+        "readable; the title keeps its own tracker's skeletons.",
+        base, size);
+    return;
+  }
+  Memory* memory = kernel_state_->memory();
+  xe::nui::SkeletonFrameSite site;
+  size_t candidates = 0;
+  const xe::nui::SkeletonSiteStatus status = xe::nui::FindSkeletonFrameSite(
+      memory->TranslateVirtual<const uint8_t*>(base), size, base, &site,
+      &candidates);
+  if (status != xe::nui::SkeletonSiteStatus::kFound) {
+    XELOGW(
+        "NUI: skeleton injection: {} ({} candidates); the title keeps its own "
+        "tracker's skeletons.",
+        xe::nui::SkeletonSiteStatusName(status), candidates);
+    return;
+  }
+
+  // Bound the way xenia binds an import: "sc 2; blr" at the thunk and a host
+  // handler on the function, before the guest can have compiled it. The
+  // producer calls the thunk only once frames flow.
+  const uint32_t address = site.frame_callback;
+  cpu::Function* function = nullptr;
+  const cpu::Symbol::Status symbol = xex->DeclareFunction(address, &function);
+  if (!function || (symbol != cpu::Symbol::Status::kNew &&
+                    symbol != cpu::Symbol::Status::kDeclared)) {
+    XELOGW(
+        "NUI: skeleton injection: the frame callback thunk at {:08X} is "
+        "already compiled; the title keeps its own tracker's skeletons.",
+        address);
+    return;
+  }
+  BaseHeap* heap = memory->LookupHeap(address);
+  uint32_t protection = 0;
+  if (!heap || !heap->QueryProtect(address, &protection) ||
+      !heap->Protect(address, 8, kMemoryProtectRead | kMemoryProtectWrite)) {
+    if (symbol == cpu::Symbol::Status::kNew) {
+      function->set_status(cpu::Symbol::Status::kDeclared);
+    }
+    XELOGW(
+        "NUI: skeleton injection: the frame callback thunk at {:08X} cannot "
+        "be written; the title keeps its own tracker's skeletons.",
+        address);
+    return;
+  }
+  static_cast<cpu::GuestFunction*>(function)->SetupExtern(
+      SkeletonFrameCallbackThunk);
+  uint8_t* code = memory->TranslateVirtual(address);
+  xe::store_and_swap<uint32_t>(code + 0, 0x44000042);  // sc 2
+  xe::store_and_swap<uint32_t>(code + 4, 0x4E800020);  // blr
+  heap->Protect(address, 8, protection);
+  function->set_end_address(address + 4);
+  function->set_status(cpu::Symbol::Status::kDeclared);
+
+  skeleton_site_ = site;
+  skeleton_inject_bound_ = true;
+  skeleton_injected_frames_ = 0;
+  skeleton_inject_start_ = std::chrono::steady_clock::now();
+  XELOGI(
+      "NUI: skeleton injection (source \"{}\"): NuiSkeletonGetNextFrame at "
+      "{:08X}, runtime state at {:08X}, frame slots at +{:X} every {:X} with "
+      "the frame at +{:X}, frame callback thunk at {:08X} (pointer at {:08X}) "
+      "called from {:08X}, now bound to the host.",
+      source, site.get_next_frame, site.runtime_state, site.slot_ring_offset,
+      site.slot_stride, site.slot_frame_offset, site.frame_callback,
+      site.frame_callback_pointer, site.frame_callback_call);
+}
+
+uint32_t NuiState::OnSkeletonFrameReady(uint32_t frame_ptr) {
+  std::lock_guard<std::mutex> lock(skeleton_inject_mutex_);
+  if (!skeleton_inject_bound_) {
+    return 0;
+  }
+  uint32_t callback = 0;
+  if (IsGuestRangeReadable(skeleton_site_.frame_callback_pointer, 4)) {
+    callback =
+        xe::load_and_swap<uint32_t>(kernel_state_->memory()->TranslateVirtual(
+            skeleton_site_.frame_callback_pointer));
+  }
+  if (!skeleton_site_.IsSlotFrame(frame_ptr) ||
+      !IsGuestRangeWritable(frame_ptr, xe::nui::kSkeletonFrameBytes)) {
+    if (skeleton_injected_frames_ == 0) {
+      XELOGW(
+          "NUI: skeleton injection: the frame callback was handed {:08X}, "
+          "which is not one of the runtime's frame slots; frame left as the "
+          "tracker made it.",
+          frame_ptr);
+      skeleton_injected_frames_ = 1;
+    }
+    return callback;
+  }
+  uint8_t* frame = kernel_state_->memory()->TranslateVirtual(frame_ptr);
+  const uint64_t injected = skeleton_injected_frames_++;
+  // Every thirty seconds or so, what the title's own tracker had found in the
+  // frame that was replaced: slot:state/id/enrollment index/user index.
+  if (injected % 900 == 0) {
+    XELOGI(
+        "NUI: skeleton injection frame {} (runtime frame {}): replaced "
+        "tracker slots [{}]{}",
+        injected, xe::load_and_swap<uint32_t>(frame + 8),
+        DescribeSkeletonSlots(frame),
+        callback ? fmt::format(", then the runtime's callback {:08X}", callback)
+                 : std::string());
+  }
+  const double seconds =
+      std::chrono::duration<double>(std::chrono::steady_clock::now() -
+                                    skeleton_inject_start_)
+          .count();
+  const xe::nui::InjectedBody body = xe::nui::MakeTestPatternBody(seconds);
+  xe::nui::WriteInjectedSkeletons(frame, &body, 0);
+  return callback;
+}
