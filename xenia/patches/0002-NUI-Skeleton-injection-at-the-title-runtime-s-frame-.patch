+constexpr uint32_t kBase = 0x82000000;
+
+// A hand-assembled stand-in for the parts of a title image the finder reads,
+// with the instruction sequences of title 4D5308ED's NUI runtime 2.0.11775
+// (registers and immediates as they are there).
+class FakeImage {
+ public:
+  FakeImage() : bytes_(0x4000, 0) {}
+
+  uint32_t Put(uint32_t offset, std::initializer_list<uint32_t> words) {
+    for (uint32_t w : words) {
+      bytes_[offset + 0] = uint8_t(w >> 24);
+      bytes_[offset + 1] = uint8_t(w >> 16);
+      bytes_[offset + 2] = uint8_t(w >> 8);
+      bytes_[offset + 3] = uint8_t(w);
+      offset += 4;
+    }
+    return offset;
+  }
+
+  // NuiSkeletonGetNextFrame, cut down to what identifies it and what it says
+  // about the state block at 0x83896510 and its slots.
+  void PutGetNextFrame(uint32_t offset) {
+    Put(offset, {
+                    0x7D8802A6,  // mflr r12
+                    0x3D608389,  // lis r11, 0x8389
+                    0x3B800000,  // li r28, 0
+                    0x3BEB6510,  // addi r31, r11, 0x6510
+                    0x2B031F40,  // cmplwi cr6, r3, 0x1F40
+                    0x1D4BD8F0,  // mulli r10, r11, -10000
+                    0x817F0A60,  // lwz r11, 0xA60(r31)
+                    0x395F0A70,  // addi r10, r31, 0xA70
+                    0x1D6B0AE0,  // mulli r11, r11, 0xAE0
+                    0x7FCB5214,  // add r30, r11, r10
+                    0x38A00AB0,  // li r5, 0xAB0
+                    0x389E0020,  // addi r4, r30, 0x20
+                    0x616A048F,  // ori r10, r11, 0x48F
+                    0x4E800020,  // blr
+                });
+  }
+
+  // if (*(g + 0x28EC)) (*(g + 0x28EC))(frame)
+  void PutThunk(uint32_t offset, uint16_t lwz_offset = 0x8DFC) {
+    Put(offset, {
+                    0x3D60838A,                // lis r11, 0x838A
+                    0x816B0000u | lwz_offset,  // lwz r11, -0x7204(r11)
+                    0x2B0B0000,                // cmplwi cr6, r11, 0
+                    0x4D9A0020,                // beqlr cr6
+                    0x7D6903A6,                // mtctr r11
+                    0x4E800420,                // bctr
+                });
+  }
+
+  void PutCall(uint32_t offset, uint32_t target_offset) {
+    const uint32_t delta = (target_offset - offset) & 0x03FFFFFC;
+    Put(offset, {0x48000001u | delta});
+  }
+
+  SkeletonSiteStatus Find(SkeletonFrameSite* site, size_t* count = nullptr) {
+    return FindSkeletonFrameSite(bytes_.data(), bytes_.size(), kBase, site,
+                                 count);
+  }
+
+ private:
+  std::vector<uint8_t> bytes_;
+};
+
+}  // namespace
+
+TEST_CASE("The skeleton frame site is read out of the runtime's own code",
+          "[nui][skeleton]") {
+  FakeImage image;
+  image.PutGetNextFrame(0x100);
+  image.PutThunk(0x400);
+  image.PutCall(0x800, 0x400);
+  SkeletonFrameSite site;
+  REQUIRE(image.Find(&site) == SkeletonSiteStatus::kFound);
+  CHECK(site.get_next_frame == kBase + 0x100);
+  CHECK(site.runtime_state == 0x83896510);
+  CHECK(site.slot_ring_offset == 0xA70);
+  CHECK(site.slot_stride == 0xAE0);
+  CHECK(site.slot_frame_offset == 0x20);
+  CHECK(site.frame_callback == kBase + 0x400);
+  CHECK(site.frame_callback_pointer == 0x83898DFC);
+  CHECK(site.frame_callback_call == kBase + 0x800);
+
+  // The two frames the producer alternates between, and nothing else.
+  CHECK(site.IsSlotFrame(0x83896510 + 0xA70 + 0x20));
+  CHECK(site.IsSlotFrame(0x83896510 + 0xA70 + 0xAE0 + 0x20));
+  CHECK_FALSE(site.IsSlotFrame(0x83896510 + 0xA70));
+  CHECK_FALSE(site.IsSlotFrame(0x83896510 + 0xA70 + 2 * 0xAE0 + 0x20));
+}
+
+TEST_CASE("Every step of the skeleton site search needs exactly one match",
+          "[nui][skeleton]") {
+  SkeletonFrameSite site;
+  size_t count = 0;
+  {
+    FakeImage image;
+    image.PutThunk(0x400);
+    image.PutCall(0x800, 0x400);
+    CHECK(image.Find(&site, &count) == SkeletonSiteStatus::kNoGetNextFrame);
+    CHECK(count == 0);
+  }
+  {
+    FakeImage image;
+    image.PutGetNextFrame(0x100);
+    image.PutGetNextFrame(0x200);
+    image.PutThunk(0x400);
+    image.PutCall(0x800, 0x400);
+    CHECK(image.Find(&site, &count) ==
+          SkeletonSiteStatus::kAmbiguousGetNextFrame);
+    CHECK(count == 2);
+  }
+  {
+    // A thunk that calls through a pointer far outside the state block is not
+    // the runtime's frame callback.
+    FakeImage image;
+    image.PutGetNextFrame(0x100);
+    image.PutThunk(0x400, 0x7FF0);
+    image.PutCall(0x800, 0x400);
+    CHECK(image.Find(&site) == SkeletonSiteStatus::kNoFrameCallback);
+  }
+  {
+    FakeImage image;
+    image.PutGetNextFrame(0x100);
+    image.PutThunk(0x400);
+    image.PutThunk(0x500);
+    image.PutCall(0x800, 0x400);
+    CHECK(image.Find(&site, &count) ==
+          SkeletonSiteStatus::kAmbiguousFrameCallback);
+    CHECK(count == 2);
+  }
+  {
+    FakeImage image;
+    image.PutGetNextFrame(0x100);
+    image.PutThunk(0x400);
+    CHECK(image.Find(&site, &count) ==
+          SkeletonSiteStatus::kFrameCallbackNotCalledOnce);
+    CHECK(count == 0);
+    image.PutCall(0x800, 0x400);
+    image.PutCall(0x900, 0x400);
+    CHECK(image.Find(&site, &count) ==
+          SkeletonSiteStatus::kFrameCallbackNotCalledOnce);
+    CHECK(count == 2);
+  }
+}
