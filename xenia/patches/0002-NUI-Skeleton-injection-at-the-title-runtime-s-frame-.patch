+// The title runtime's frame callback thunk, once BindSkeletonInjection has
+// bound it: r3 is the finished NUI_SKELETON_FRAME. The thunk's own job, calling
+// through the runtime's callback pointer when it is set, is kept, after the
+// frame has been rewritten.
+void SkeletonFrameCallbackThunk(cpu::ppc::PPCContext* ppc_context,
+                                KernelState* kernel_state) {
+  const uint32_t frame_ptr = static_cast<uint32_t>(ppc_context->r[3]);
+  NuiState* nui_state = kernel_state->xam_state()
+                            ? kernel_state->xam_state()->nui_state()
+                            : nullptr;
+  const uint32_t callback =
+      nui_state ? nui_state->OnSkeletonFrameReady(frame_ptr) : 0;
+  if (callback) {
+    uint64_t args[] = {frame_ptr};
+    ppc_context->r[3] = kernel_state->processor()->Execute(
+        ppc_context->thread_state, callback, args, 1);
+  }
+}
+
+// What the frame's slots held before they were rewritten, for the log.
+std::string DescribeSkeletonSlots(const uint8_t* frame) {
+  std::string slots;
+  for (uint32_t n = 0; n < xe::nui::kInjectSkeletonCount; ++n) {
+    const uint8_t* skeleton = frame + xe::nui::kInjectSkeletonDataOffset +
+                              n * xe::nui::kInjectSkeletonDataBytes;
+    fmt::format_to(std::back_inserter(slots), "{}{}:{}/{}/{}/{}", n ? " " : "",
+                   n, xe::load_and_swap<uint32_t>(skeleton),
+                   xe::load_and_swap<uint32_t>(skeleton + 4),
+                   xe::load_and_swap<int32_t>(skeleton + 8),
+                   xe::load_and_swap<uint32_t>(skeleton + 12));
+  }
+  return slots;
+}
